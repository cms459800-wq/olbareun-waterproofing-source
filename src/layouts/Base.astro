---
import '../styles.css';
const { title, description, active = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const links = [
  { href: '/', label: '홈', key: 'home' },
  { href: '/roof/', label: '옥상 방수', key: 'roof' },
  { href: '/bathroom/', label: '욕실 방수', key: 'bathroom' },
  { href: '/exterior/', label: '외벽 방수', key: 'exterior' },
  { href: '/process/', label: '점검과 시공', key: 'process' },
  { href: '/about/', label: '소개', key: 'about' },
];
---
<!doctype html>
<html lang="ko"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><meta name="robots" content="index,follow" />
  <meta name="naver-site-verification" content="f5e7c10abde8093fffe33e0ca276f9b2dcd89fe4" />
  <link rel="canonical" href={canonical} /><link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <meta property="og:type" content="website" /><meta property="og:locale" content="ko_KR" /><meta property="og:site_name" content="올바른방수" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head><body>
  <a class="skip" href="#main">본문 바로가기</a>
  <header class="site-header"><div class="wrap header-inner"><a href="/" class="brand" aria-label="올바른방수 홈"><span class="brand-icon" aria-hidden="true">O</span><span>올바른<span class="brand-accent">방수</span></span></a><nav aria-label="주요 메뉴"><ul>{links.map(link => <li><a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav></div></header>
  <main id="main"><slot /></main>
  <footer class="site-footer"><div class="wrap footer-grid"><div><strong>올바른방수</strong><p>누수의 흔적부터 시공 후 확인까지,<br />방수 작업의 기준을 차근차근 살펴봅니다.</p></div><nav aria-label="하단 메뉴"><a href="/roof/">옥상 방수</a><a href="/bathroom/">욕실 방수</a><a href="/exterior/">외벽 방수</a><a href="/process/">점검과 시공</a><a href="/about/">소개</a></nav></div></footer>
</body></html>
